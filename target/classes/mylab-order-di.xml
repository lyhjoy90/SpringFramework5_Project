<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- 1. product1: Setter Injection -->
    <bean id="product1" class="mylab.order.Product">
        <property name="id" value="P001" />
        <property name="name" value="노트북" />
        <property name="price" value="150000" />
    </bean>

    <!-- 2. product2: Constructor Injection -->
    <bean id="product2" class="mylab.order.Product">
        <constructor-arg value="P002" />
        <constructor-arg value="스마트폰" />
        <constructor-arg value="800000" />
    </bean>

    <!-- 3. shoppingCart: List Setter Injection -->
    <bean id="shoppingCart" class="mylab.order.ShoppingCart">
        <property name="products">
            <list>
                <ref bean="product1"/>
                <ref bean="product2"/>
            </list>
        </property>
    </bean>

    <!-- 4. orderService: ShoppingCart Setter Injection -->
    <bean id="orderService" class="mylab.order.OrderService">
        <property name="shoppingCart" ref="shoppingCart" />
    </bean>

</beans>